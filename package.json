{
  "name": "ryoshoku",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.7"
  },
  "scripts": {
    "start": "NODE_ENV=production bun run src/cli.ts start",
    "dev": "NODE_ENV=development bun --watch --no-clear-screen src/cli.ts start",
    "extract": "bun run src/cli.ts extract",
    "test": "bun test",
    "test:python": "uv run pytest -q",
    "typecheck": "tsc --noEmit",
    "benchmark": "uv run python scripts/benchmark.py"
  }
}
